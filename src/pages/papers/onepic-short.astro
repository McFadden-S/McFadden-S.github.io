        <path class="box" d="M90 70H280V100L270 110H80V80Z"/>
        <text class="t-b mid" x="180" y="95">text-image query q</text>
        <path class="ln" d="M180 110 V136" marker-end="url(#ah-contrast)"/>
        <text class="t-sm t-muted" x="190" y="127">shares text with q</text>
        <path class="box-red" d="M90 140H280V186L270 196H80V150Z"/>
        <text class="t-mono t-red mid" x="180" y="162">INJECTED KB ENTRY</text>
        <text class="t-sm mid" x="180" y="182">request + malicious response</text>
        <path class="ln" d="M180 196 V222" marker-end="url(#ah-contrast)"/>
        <text class="t-sm t-muted" x="190" y="213">LMM reads the text</text>
        <path class="box" d="M90 226H280V256L270 266H80V236Z"/>
        <text class="t-b t-red mid" x="180" y="251">malicious response</text>

        <path class="zone" d="M384 10H710V266L696 280H370V24Z"/>
        <text class="t-mono t-red" x="386" y="36">VD-RAG (THIS PAPER)</text>
        <text class="t-sm t-muted" x="386" y="54">KB holds document page images only</text>
        <path class="box" d="M450 70H640V100L630 110H440V80Z"/>
