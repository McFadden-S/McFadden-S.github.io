    <h3>Six key dimensions</h3>
    <div class="explorer">
      <div class="ex-tabs" aria-label="Corpus dimensions">
        <button class="ex-tab" aria-controls="cx-form" aria-selected="true">Formulation</button>
        <button class="ex-tab" aria-controls="cx-gran">Granularity</button>
