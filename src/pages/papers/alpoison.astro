<script>
  const fig = document.getElementById('t3');
  const body = document.getElementById('t3-body');
  const note = document.getElementById('t3-note');
  if (fig && body && note) {
    type Row = [(number | null)[], number[]];
    const D: Record<string, Record<string, Row[]>> = JSON.parse(fig.dataset.t3 ?? '{}');
    const AL = ['0% (none)', '2%', '4%', '8%', '16%'];
    const NAME: Record<string, string> = { SVM: 'Linear SVM', DNN: 'DNN', RF: 'Random Forest' };
    let m = '0.05';
    let c = 'SVM';
    const cell = (I: number | null, R: number) =>
      `<td class="cell" style="--mix:${Math.round(R * 0.55)}%"><b>${R}%</b><small>${I === null ? 'X<span class="wide-only">, never reached</span>' : '<span class="wide-only">from </span>month ' + I}</small></td>`;
    const render = () => {
      body.innerHTML = D[m][c]
        .map((row, i) => `<tr><th scope="row">${AL[i]}</th>${row[0].map((I, k) => cell(I, row[1][k])).join('')}</tr>`)
        .join('');
      note.textContent = `${NAME[c]}, tolerance margin ${m}. Cells: recovery rate, then intercept month.`;
    };
    const wire = (attr: string, set: (v: string) => void) => {
      const btns = [...fig.querySelectorAll<HTMLButtonElement>(`[${attr}]`)];
      for (const b of btns) {
        b.addEventListener('click', () => {
          for (const o of btns) o.setAttribute('aria-pressed', String(o === b));
          set(b.getAttribute(attr) ?? '');
          render();
        });
      }
    };
    wire('data-m', (v) => (m = v));
    wire('data-c', (v) => (c = v));
    render();
  }
</script>
