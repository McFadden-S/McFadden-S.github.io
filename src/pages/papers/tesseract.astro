<script>
  type Split = 'cv' | 'inc' | 'win' | 'real';
  type Clf = 'drebin' | 'deep';
  type Pill = 'ok' | 'bad' | 'maybe';

  const lab = document.getElementById('lab');
  if (lab) {
    const F1: Record<Split, Record<Clf, Record<string, number>>> = {
      cv: { drebin: { '10/10': 0.85, '90/10': 0.55, '10/90': 0.91, '90/90': 0.98 }, deep: { '10/10': 0.84, '90/10': 0.51, '10/90': 0.88, '90/90': 0.98 } },
      inc: { drebin: { '10/10': 0.64, '90/10': 0.48, '10/90': 0.71, '90/90': 0.49 }, deep: { '10/10': 0.62, '90/10': 0.38, '10/90': 0.66, '90/90': 0.92 } },
      win: { drebin: { '10/10': 0.3, '90/10': 0.42, '10/90': 0.31, '90/90': 0.77 }, deep: { '10/10': 0.37, '90/10': 0.42, '10/90': 0.39, '90/90': 0.78 } },
      real: { drebin: { '10/10': 0.47, '90/10': 0.39, '10/90': 0.53, '90/90': 0.8 }, deep: { '10/10': 0.36, '90/10': 0.39, '10/90': 0.39, '90/90': 0.84 } },
    };
    const SPLIT: Record<Split, { c1: Pill; c2: Pill; y: Record<string, number[]>; note: string }> = {
      cv: {
        c1: 'bad', c2: 'maybe',
        y: { tg: [1, 1, 1, 1, 1], tm: [1, 1, 1, 1, 1], sg: [1, 1, 1, 1, 1], sm: [1, 1, 1, 1, 1] },
        note: 'K-fold CV is likely to include in the training set at least one sample of each malware family in the dataset, whereas new families will be unknown at training time in a real-world deployment.',
      },
      inc: {
        c1: 'bad', c2: 'ok',
        y: { tg: [0, 0, 1, 0, 0], tm: [0, 0, 1, 0, 0], sg: [1, 1, 0, 1, 1], sm: [1, 1, 0, 1, 1] },
        note: 'High performance should be expected from a classifier in such a scenario: if the classifier contains at least one variant of a past malware family, it will likely identify similar variants.',
      },
      win: {
        c1: 'ok', c2: 'bad',
        y: { tg: [0, 1, 0, 0, 0], tm: [1, 0, 0, 0, 0], sg: [0, 0, 0, 0, 1], sm: [0, 0, 1, 0, 0] },
        note: 'Even though the testing objects for malware come after the training objects, the time windows for goodware and malware do not overlap. This situation can lead to the classifier learning to distinguish between applications from different time periods rather than differentiating between goodware and malware, thereby resulting in artificially inaccurate performance.',
      },
      real: {
        c1: 'ok', c2: 'ok',
        y: { tg: [1, 0, 0, 0, 0], tm: [1, 0, 0, 0, 0], sg: [0, 1, 1, 1, 1], sm: [0, 1, 1, 1, 1] },
        note: 'The realistic setting, where training is temporally precedent to testing, causes the worst classifier performance in the majority of cases.',
      },
    };
    const NOTE_TRAIN_90 = 'As the percentage of malware in the training set increases, Precision decreases while Recall increases.';
    const NOTE_TEST_90 = 'In this unrealistic setting, where the percentage of malware in the testing is artificially increased, Precision for malware increases while Recall remains similar.';
    const NAME: Record<Clf, string> = { drebin: 'DREBIN', deep: 'DEEPDREBIN' };
    const st = { split: 'cv' as Split, tr: '10', ts: '10', clf: 'drebin' as Clf };
    const byId = (id: string) => document.getElementById(id) as HTMLElement;

    const pill = (el: HTMLElement, state: Pill) => {
      el.className = state === 'ok' ? '' : state;
      const cs = el.querySelector<HTMLElement>('.cs');
      if (cs) cs.textContent = state === 'ok' ? 'holds' : state === 'bad' ? 'violated' : 'may be violated';
    };

    const render = () => {
      const v = F1[st.split][st.clf][`${st.tr}/${st.ts}`];
      const ref = F1.real[st.clf]['10/10'];
      const isRef = st.split === 'real' && st.tr === '10' && st.ts === '10';
      const d = v - ref;
      byId('labF1').textContent = v.toFixed(2);
      byId('labCap').textContent = isRef
        ? `${NAME[st.clf]}, realistic setting`
        : `${NAME[st.clf]}, realistic setting: ${ref.toFixed(2)}, difference: ${d >= 0 ? '+' : '−'}${Math.abs(d).toFixed(2)}`;
      const s = SPLIT[st.split];
      pill(byId('labC1'), s.c1);
      pill(byId('labC2'), s.c2);
      pill(byId('labC3'), st.ts === '90' ? 'bad' : 'ok');
      for (const [row, yrs] of Object.entries(s.y)) {
        lab.querySelectorAll<HTMLElement>(`#labYrs i[data-r="${row}"]`).forEach((el, i) => {
          el.className = yrs[i] ? (row[0] === 't' ? 'tr' : 'ts') : '';
        });
      }
      const notes = [s.note];
      if (st.tr === '90') notes.push(NOTE_TRAIN_90);
      if (st.ts === '90') notes.push(NOTE_TEST_90);
      byId('labNote').textContent = notes.join(' ');
    };

    lab.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-k]');
      if (!b) return;
      const k = b.dataset.k as keyof typeof st;
      (st as Record<string, string>)[k] = b.dataset.v ?? '';
      lab.querySelectorAll<HTMLButtonElement>(`button[data-k="${k}"]`).forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      render();
    });
    render();
  }
</script>
